# Copy to .env (never commit .env). Values come from your logged-in browser:
# booksy.com -> F12 -> Network -> any request to pl.booksy.com/core/... -> Request Headers.
BOOKSY_API_KEY=
BOOKSY_ACCESS_TOKEN=
# optional: same as in the browser (X-Fingerprint, X-App-Version); a random fingerprint is used when empty
BOOKSY_FINGERPRINT=
BOOKSY_APP_VERSION=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# your chat id; the bot replies with it to /start when empty
TELEGRAM_CHAT_ID=
# check interval in minutes (random within range, min 2)
CHECK_MINUTES=5-10
# optional: booking-opening window: days of month, local hours, seconds between autobook checks (min 5)
# FAST_WINDOW=1-3 19:55-20:35 10
# password friends give after /start to join the bot (empty = nobody can join)
BOT_PASSWORD=
